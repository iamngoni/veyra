<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Every two minutes, watches the stack through the loopback control surface and
  pushes transitions and trade events to VEYRA_ALERT_WEBHOOK. With no webhook
  configured, findings land in ~/Library/Logs/veyra/alert.out.log instead.
-->
<dict>
    <key>Label</key>
    <string>cc.antonlabs.veyra.alerts</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>__ROOT__/scripts/alert-probe.py</string>
    </array>
    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/veyra/alert.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/veyra/alert.err.log</string>
</dict>
</plist>
