<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Daily verified backup of the Veyra audit database, keeping the newest
  fourteen dumps under ~/Library/Application Support/veyra/backups. Runs once
  at load so a fresh dump exists after every login, and daily at 03:30
  thereafter (launchd fires missed schedules on wake).
-->
<dict>
    <key>Label</key>
    <string>cc.antonlabs.veyra.backup</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/scripts/backup-postgres.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/veyra/backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/veyra/backup.err.log</string>
</dict>
</plist>
