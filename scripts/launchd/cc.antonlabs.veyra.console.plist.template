<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Serves the built operations console on http://127.0.0.1:3000. The console
  reads the loopback control surface through its own /api proxy; nothing is
  exposed beyond this machine.
-->
<dict>
    <key>Label</key>
    <string>cc.antonlabs.veyra.console</string>
    <key>ProgramArguments</key>
    <array>
        <string>__ROOT__/console/scripts/serve.sh</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/veyra/console.out.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/veyra/console.err.log</string>
</dict>
</plist>
