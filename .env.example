# Veyra settings template. Copy it to `.env` (never commit that copy).
#
# As shipped, every optional integration is off, so the service starts with no
# edits. Turn each section on when you need it: a section with some values set
# but its required ones missing fails startup and names the missing setting.
# GETTING_STARTED.md walks through each stage.

# Bind address for the local service. Never expose Veyra directly to the internet.
VEYRA_BIND_HOST=127.0.0.1
VEYRA_BIND_PORT=8080

# deployment: production, staging, or development
VEYRA_ENV=development

# Optional JSON log filter, for example info,veyra=debug
RUST_LOG=info

# ---- Broker: EA control channel ----
# Selects the broker integration implementation. Leave unset to disable broker
# integration entirely; every other setting in this section must then be empty
# too. Supported: ea (requires VEYRA_EA_TOKEN).
VEYRA_BROKER_PROVIDER=

# Shared secret the EA presents on every poll: 16-128 letters, digits, `-` or
# `_`. Generate with:
#   openssl rand -hex 24
VEYRA_EA_TOKEN=

# Listener for the EA control channel (empty = 127.0.0.1, port 7801). Host
# deployments must keep this on loopback. An isolated Docker network may bind
# 0.0.0.0 only when VEYRA_EA_ALLOW_NON_LOOPBACK is true (empty = false); never
# publish this port to the host or LAN.
VEYRA_EA_BIND_HOST=
VEYRA_EA_BIND_PORT=
VEYRA_EA_ALLOW_NON_LOOPBACK=

# ---- Decision model ----
# Selects the decision provider. Leave this section empty to disable model
# integration; once any value here is set, the provider's key (where it needs
# one) and the three tier models are required.
# Supported: openrouter, openai, anthropic, groq, deepseek, xai, mistral,
# kimi, zai (Z.AI / Zhipu GLM; aliases z-ai, zhipu), ollama, codex (ChatGPT
# subscription), claude_code (Claude Code subscription), custom (an
# OpenAI-compatible endpoint). Connect subscriptions in the console before
# selecting them as the active model provider. zai uses native model ids
# (glm-5.3, glm-5.3-flash), defaults to https://api.z.ai/api/paas/v4, and is
# always sent tool_choice "auto" because it rejects a compelled choice.
VEYRA_MODEL_PROVIDER=

# Provider API key. Never commit a real value. Not used for Ollama or connected
# subscriptions.
VEYRA_MODEL_API_KEY=

# Optional base URL override; custom requires one. Named providers use their
# standard endpoint by default.
VEYRA_MODEL_BASE_URL=

# To save keys from the console, configure BOTH values below in the untracked
# deployment .env. The secret key must be a base64-encoded 32-byte random key;
# the operator token must have at least 32 characters. A database is required.
# Keep the encryption key across restarts or saved credentials cannot decrypt.
# Console notifications need both as well. Generate them with:
#   openssl rand -base64 32   (secret key)
#   openssl rand -hex 32      (operator token)
VEYRA_CONSOLE_SECRET_KEY=
VEYRA_CONSOLE_ADMIN_TOKEN=

# Per-tier models. They must support structured answers. Disable
# VEYRA_MODEL_COMPEL_STRUCTURED for reasoning models that reject forced tools.
VEYRA_MODEL_FAST=
VEYRA_MODEL_BALANCED=
VEYRA_MODEL_REASONING=

# true (empty) tells the provider it must answer through the response schema;
# false only offers it. Reasoning ("thinking") models reject a compelled choice
# with an HTTP 400, so they need false. zai is always sent "auto" regardless.
VEYRA_MODEL_COMPEL_STRUCTURED=

# Optional fallback chain, tried in order when the tier's primary cannot serve
# a decision: the account is out of credits on that model (HTTP 402), the
# provider is rate limiting or overloaded, the model is rejected outright, or
# the answer does not satisfy the schema. A transport failure is not failed
# over to another model on the same provider — the host was never reached, so
# the next candidate would fail the same way and the retry policy already
# covers it — but it does fall through from the ChatGPT subscription to this
# provider.
#
# Comma-separated model identifiers, at most 4 per tier. OpenRouter uses
# `vendor/model`; other providers use their native model names. Every extra
# candidate costs a live round trip during an outage, so a deep chain turns one
# slow tick into a very slow one. Each candidate must accept the structured
# response path used by the active primary. The identifiers below are a
# deployment example; they must also be permitted by the OpenRouter account's
# allowed-provider policy.
#
# This shared list applies to every tier. Example for an OpenRouter account
# that permits these providers:
#   VEYRA_MODEL_FALLBACKS=z-ai/glm-5.3-flash,xiaomi/mimo-v2.6-flash,z-ai/glm-4.7-flash
VEYRA_MODEL_FALLBACKS=

# Optional per-tier chains. Setting one *replaces* the shared list for that
# tier rather than extending it, so a narrow override never has to restate it.
VEYRA_MODEL_FAST_FALLBACKS=
VEYRA_MODEL_BALANCED_FALLBACKS=
VEYRA_MODEL_REASONING_FALLBACKS=

# Optional attribution header sent to OpenRouter.
VEYRA_MODEL_HTTP_REFERER=
# Display name shown with the attribution URL. Requires the referer above.
VEYRA_MODEL_APP_TITLE=
# Set true to keep the attributed app out of public rankings. Unset leaves the
# provider's default (public). Visibility is fixed on the first request the
# provider ever receives and cannot be changed afterwards.
VEYRA_MODEL_APP_HIDDEN=

# ChatGPT subscription first. When the ChatGPT (codex) subscription is
# connected in the console and this is true (empty = true), every model call —
# autopilot decisions, one-shot proposals, and the read-only assistant — tries
# the subscription first, then the provider above and its fallback chain when
# the subscription cannot serve the call (out of quota, rate limited,
# overloaded, rejected, or an unusable answer). Set false to use only the
# provider above. It never applies when VEYRA_MODEL_PROVIDER is codex (already
# the subscription) or claude_code, and it does nothing without a configured
# model section. Both settings are live: editable from the console Settings.
VEYRA_MODEL_PREFER_SUBSCRIPTION=
# Model sent to the ChatGPT subscription for every tier (empty = gpt-6-luna).
# The tier models above belong to the configured provider and are never sent
# to the subscription.
VEYRA_MODEL_CHATGPT_MODEL=

# Cooldowns (not configurable): a model candidate that fails in a way another
# model could avoid is skipped, without a request, for a period that doubles
# on each repeat up to a cap — out of credits 30 min (cap 4 h), rejected model
# such as an OpenRouter account's excluded provider 60 min (cap 12 h), auth
# refused 60 min (cap 12 h), rate limited Retry-After or 2 min (cap 30 min),
# overloaded/5xx 1 min (cap 15 min), unusable answer 5 min (cap 30 min). After
# the period one probe request decides whether it recovered. A transport fault
# (host unreachable) holds every candidate on that host as `unreachable` for
# 1 min (doubling, cap 5 min) and moves on to the next host, so a ChatGPT
# outage falls through to the provider above; the first answer from the host
# releases its holds. Cooldowns clear when the provider, key, model lists, or
# subscription connection change, and from POST /model/cooldowns/clear;
# /status reports them as model_cooldowns next to model_route.

# ---- Risk gate (deterministic, fail-closed) ----
# Comma-separated instrument allowlist. Write each symbol exactly as the
# broker spells it (MT4 names can be mixed-case, e.g. SP500m): approved orders
# are sent under this spelling, while matching ignores case. Empty means no
# instrument is approved.
VEYRA_RISK_SYMBOLS=

# Optional subset of the allowlist whose venue trades through the standard FX
# weekend (for example BTCUSD,ETHUSD). The live contract must still report
# tradeAllowed with positive tick size/value; venue maintenance fails closed.
VEYRA_RISK_WEEKEND_SYMBOLS=

# Optional groups of allowlisted instruments that move together, at most one
# open position per group: members joined by '+', groups separated by commas,
# e.g. SP500m+Nd100m,BTCUSD+ETHUSD. Each symbol belongs to at most one group.
VEYRA_RISK_CORRELATED_GROUPS=

# true engages the kill switch: every intent is rejected.
VEYRA_RISK_KILL_SWITCH=false

# DANGER: true lets the service queue real order execution
# (POST /intents/execute). Leave false unless you have approved live trading;
# the terminal still requires its own InAllowLiveOrders input.
#
# This is the startup baseline only: the switch is live, so the console can
# arm or disarm it through POST /config without a restart, and the value it
# was last set to is restored on the next start.
VEYRA_TRADING_ENABLED=false

# Largest lot volume a single intent may request (greater than 0, at most 100).
VEYRA_RISK_MAX_VOLUME_PER_ORDER=0.01

# Largest total open volume across existing orders plus a new intent, in lots.
VEYRA_RISK_MAX_TOTAL_LOTS=0.01

# Largest number of open venue orders tolerated (0 through 1000).
VEYRA_RISK_MAX_OPEN_ORDERS=1

# Seconds within which an identical approved intent is suppressed; 0 disables
# duplicate suppression.
VEYRA_RISK_DUPLICATE_WINDOW_SECS=60

# Optional UTC session window, for example 7-21 or 22-6 (wraps midnight).
VEYRA_RISK_SESSION_HOURS_UTC=

# Largest risk one trade may carry, as a percentage of equity: the loss if its
# stop is hit. 0-100, 0 disables; empty = 12.
VEYRA_RISK_MAX_RISK_PERCENT=

# Breakers that block new entries (never closes) once equity falls this far, in
# percent, below the UTC day's opening equity (empty = 10) or below the highest
# equity since startup (empty = 25). 0-100, 0 disables.
VEYRA_RISK_MAX_DAILY_LOSS_PERCENT=
VEYRA_RISK_MAX_PEAK_DRAWDOWN_PERCENT=

# Cap on net US-dollar-directional exposure across open positions, in lots,
# so several pairs cannot stack the same bet. 0-100, 0 disables; empty = 0.01.
VEYRA_RISK_MAX_NET_FACTOR_LOTS=

# Minutes either side of a high-impact calendar event during which new entries
# for an affected instrument are refused. 0-1440, 0 disables; empty = 30. Needs
# VEYRA_CALENDAR_PROVIDER; with a calendar configured but unreachable, entries
# are refused rather than traded blind.
VEYRA_RISK_CALENDAR_BLACKOUT_MINUTES=

# Smallest stop distance accepted, as a fraction of ATR(14), so a stop cannot
# sit inside ordinary noise. 0-2, 0 disables; empty = 0.25.
VEYRA_RISK_MIN_STOP_ATR_FRACTION=

# With Jev configured, the autopilot pauses when Jev cannot answer. true lets
# it decide without judgements instead. Empty = false.
VEYRA_RISK_ALLOW_TRADING_WITHOUT_JEV=

# What happens to open positions before the Friday close: agent (the model
# reviews each one and decides), hold (keep them), or flatten (close them all
# without a model call). Empty = agent.
VEYRA_RISK_WEEKEND_POSITIONS=

# Seconds between automatic broker-state refreshes (0 disables them). The
# refresh keeps close/modify guards and GET /reconciliation current.
VEYRA_RECONCILE_SECS=30

# ---- Persistence (audit trail) ----
# PostgreSQL connection string, for example postgres://localhost/veyra. Unset
# disables durable auditing; a configured but unreachable server fails startup.
VEYRA_DATABASE_URL=

# Days of audit history to keep; the service prunes hourly. 0 keeps everything.
VEYRA_AUDIT_RETENTION_DAYS=30

# ---- Jev decision adapter (TypeSafe System One) ----
# API key for the Jev decision service. Leave the whole section empty to
# disable the adapter; any other value here without a key fails startup.
VEYRA_JEV_API_KEY=

# Optional provider selector. Supported: typesafe (the default once a key is set).
VEYRA_JEV_PROVIDER=

# Optional base URL override; defaults to https://api.typesafe.ai. Plain http
# is accepted only on loopback, for tests.
VEYRA_JEV_BASE_URL=

# Optional model alias; defaults to jev-latest.
VEYRA_JEV_MODEL=

# ---- Autopilot (autonomous decision loop) ----
# Runs a decision every interval: market data, optional Jev judgements, one
# structured model proposal, the deterministic risk gate, then the same staged
# execution as the control surface. Disabled by default; the first tick runs
# one interval after startup. Every autonomous entry must carry both a stop
# loss and a take profit.
VEYRA_AUTOPILOT_ENABLED=false

# Optional single instrument; defaults to the terminal's chart symbol. Do not
# set this together with VEYRA_AUTOPILOT_SYMBOLS.
VEYRA_AUTOPILOT_SYMBOL=

# Optional comma-separated rotation of up to 16 instruments. The AI chooses at
# most one per tick and the deterministic risk allowlist remains authoritative.
VEYRA_AUTOPILOT_SYMBOLS=

# Optional timeframe name or minutes; defaults to H4.
VEYRA_AUTOPILOT_TIMEFRAME=

# Optional closed-candle window, 10-240; defaults to 48.
VEYRA_AUTOPILOT_BARS=

# Optional model tier: fast, balanced, or reasoning; defaults to balanced.
VEYRA_AUTOPILOT_TIER=

# Optional cadence in seconds, 30-86400; defaults to 300.
VEYRA_AUTOPILOT_INTERVAL_SECS=

# Optional judgement preference: auto (consult Jev when configured) or off.
VEYRA_AUTOPILOT_JEV=

# Optional minimum position age before the loop may close it, 0-86400 seconds
# (default 300; 0 disables the guard). Positions whose age cannot be verified
# are never closed autonomously.
VEYRA_AUTOPILOT_MIN_HOLD_SECS=

# Fraction of ATR(14) a candidate must move inside a candle before the entry
# sweep asks the model again. New closed candles always reopen it; this only
# adds a mid-candle trigger. 0 disables it, leaving candles as the sole
# trigger. Defaults to 0.25.
VEYRA_AUTOPILOT_ENTRY_MOVE_ATR=

# Optional break-even policy: multiple of the entry risk (1 = the full stop
# distance) at which the stop moves to the entry price, 0-10 (default 0,
# disabled). Runs before the model review and only when the switch is on.
VEYRA_AUTOPILOT_BREAKEVEN_R=

# Optional trailing policy: once the trade is that many risk units in favour,
# keep the stop that far behind the best price, 0-10 (default 0, disabled).
# The most protective candidate wins over break-even; improvements smaller
# than a tenth of the entry risk are suppressed to bound modify churn.
VEYRA_AUTOPILOT_TRAIL_R=

# Optional deterministic early-profit mode. When true, Veyra observes live
# net floating profit (including spread, swap, and reported commission), moves
# a one-way broker stop after the arm threshold, and banks the position when
# the configured fraction of its best profit is surrendered while still
# positive. A dedicated position loop evaluates this on the main autopilot
# cadence even while a slower market/model decision sweep is still running.
#
# On by default. The switch is live, so it can be disarmed from the console
# without a restart — which matters because this is the one autopilot feature
# that acts on already-open positions.
VEYRA_AUTOPILOT_PROFIT_HARVEST=true

# Entry-risk multiple required to arm (default 0.20) and distance kept behind
# favourable price after arming (default 0.20). Trail must not exceed arm.
VEYRA_AUTOPILOT_HARVEST_ARM_R=
VEYRA_AUTOPILOT_HARVEST_TRAIL_R=

# Minimum net floating profit in account currency before arming (default 0.50)
# and fraction of the high-water profit surrendered before closing (default
# 0.35, accepted 0.05-0.95).
VEYRA_AUTOPILOT_HARVEST_MIN_PROFIT=
VEYRA_AUTOPILOT_HARVEST_GIVEBACK=

# Minimum age before harvesting (default 300 seconds) and same-symbol re-entry
# cooldown after any observed close (default 900 seconds). A post-close entry
# also requires a fresh candle or a new ATR-scaled move from the exit area.
VEYRA_AUTOPILOT_HARVEST_MIN_HOLD_SECS=
VEYRA_AUTOPILOT_HARVEST_REENTRY_COOLDOWN_SECS=

# ---- Market data ----
# Provider for candles. Supported: ea (closed candles through the EA control
# channel). Leave unset to disable the market view.
VEYRA_MARKET_PROVIDER=

# Optional: how long one rates round trip may take before it is reported
# unavailable, 5-120 seconds (default 20; must outlive the 15s command timeout).
VEYRA_MARKET_EA_AWAIT_SECS=

# ---- Economic calendar ----
# Scheduled-news source for the model's context and the news blackout above.
# Supported: forexfactory (weekly export, no key). Leave the section empty to
# disable it.
VEYRA_CALENDAR_PROVIDER=

# Optional: seconds one calendar request may take, 1-60 (default 5), and how
# long a fetched week is reused, 60-86400 seconds (default 900).
VEYRA_CALENDAR_HTTP_TIMEOUT_SECS=
VEYRA_CALENDAR_CACHE_SECS=

# ---- Backups ----
# Off-machine backup: an R2 bucket that receives every fresh dump through the
# authenticated `wrangler` CLI. Leave the bucket unset for local-only backups.
VEYRA_BACKUP_R2_BUCKET=

# Optional absolute path to the wrangler binary (launchd starts with a minimal
# PATH and the node shebang needs the binary's directory on PATH).
VEYRA_WRANGLER_BIN=

# ---- Notifications and outage watchdog ----
# Notifications (email, Telegram, Discord, Slack, ntfy, Pushover, webhook)
# are configured in the console's Notifications tab, not here;
# they need the console secret storage above. See docs/notifications.md.
#
# The outage watchdog (`veyra-service watchdog`) reads these. All optional:
# where to find the service (compose and launchd set this for you), seconds
# between checks (10-3600, default 60), and failed checks before alerting
# (1-60, default 3).
VEYRA_WATCHDOG_URL=
VEYRA_WATCHDOG_INTERVAL_SECS=
VEYRA_WATCHDOG_FAILURES=

# ---- Model call budget ----
# Bound the decision engine's provider calls so a runaway loop (an interval
# typo, a retry storm) cannot silently multiply cost. 0 = unlimited (default).
# One tick per minute is 1440 calls per day.
VEYRA_MODEL_MAX_CALLS_PER_HOUR=
VEYRA_MODEL_MAX_CALLS_PER_DAY=

# ---- EA compile-time settings (scripts/compile_ea.sh) ----
# Endpoint the compiled EA polls. MQL4 WebRequest only allows the
# scheme-default ports (80/443), so a tunnelled HTTPS URL is required whenever
# the terminal is not on the same host as the service. Leaving this unset bakes
# in the loopback default, which a Wine terminal cannot reach.
VEYRA_EA_URL=

# Compiled default of the EA's InAllowLiveOrders input: the second of the two
# execution controls (the first is VEYRA_TRADING_ENABLED above). false (also
# the script's default when unset) makes execution commands report dry runs.
# Set true only once live trading is approved. It is a compiled default, not a
# lock: the input stays editable in the terminal's EA properties, and the
# service must still agree before any command reaches the terminal.
VEYRA_EA_ALLOW_LIVE=false
