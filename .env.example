# Bind address for the local service. Never expose Veyra directly to the internet.
VEYRA_BIND_HOST=127.0.0.1
VEYRA_BIND_PORT=8080

# deployment: production, staging, or development
VEYRA_ENV=development

# Optional JSON log filter, for example info,veyra=debug
RUST_LOG=info

# ---- Broker: EA control channel ----
# Selects the broker integration implementation. Leave unset to disable broker
# integration entirely. Supported: ea.
VEYRA_BROKER_PROVIDER=ea

# Shared secret the EA presents on every poll. Generate with:
#   openssl rand -hex 24
VEYRA_EA_TOKEN=

# Listener for the EA control channel. Host deployments must keep this on
# loopback. An isolated Docker network may bind 0.0.0.0 only when the explicit
# opt-in below is true; never publish this port to the host or LAN.
VEYRA_EA_BIND_HOST=127.0.0.1
VEYRA_EA_BIND_PORT=7801
VEYRA_EA_ALLOW_NON_LOOPBACK=false

# ---- Model: OpenRouter-compatible endpoint ----
# Selects the decision provider. Leave unset to disable model integration.
# Supported: openrouter.
VEYRA_MODEL_PROVIDER=openrouter

# Provider API key. Never commit a real value.
VEYRA_MODEL_API_KEY=

# Optional base URL override; defaults to the OpenRouter endpoint.
VEYRA_MODEL_BASE_URL=

# Per-tier models. Tier models must accept forced tool calls, because the
# response schema is enforced through tool_choice.
VEYRA_MODEL_FAST=
VEYRA_MODEL_BALANCED=
VEYRA_MODEL_REASONING=

# Optional attribution header sent to OpenRouter.
VEYRA_MODEL_HTTP_REFERER=
# Display name shown with the attribution URL. Requires the referer above.
VEYRA_MODEL_APP_TITLE=
# Set true to keep the attributed app out of public rankings. Unset leaves the
# provider's default (public). Visibility is fixed on the first request the
# provider ever receives and cannot be changed afterwards.
VEYRA_MODEL_APP_HIDDEN=

# ---- Risk gate (deterministic, fail-closed) ----
# Comma-separated instrument allowlist, normalised to upper case. Empty means
# no instrument is approved.
VEYRA_RISK_SYMBOLS=

# true engages the kill switch: every intent is rejected.
VEYRA_RISK_KILL_SWITCH=false

# DANGER: true lets the service queue real order execution
# (POST /intents/execute). Leave false unless you have approved live trading;
# the terminal still requires its own InAllowLiveOrders input.
VEYRA_TRADING_ENABLED=false

# Largest lot volume a single intent may request (greater than 0, at most 100).
VEYRA_RISK_MAX_VOLUME_PER_ORDER=0.01

# Largest total open volume across existing orders plus a new intent, in lots.
VEYRA_RISK_MAX_TOTAL_LOTS=0.01

# Largest number of open venue orders tolerated (0 through 1000).
VEYRA_RISK_MAX_OPEN_ORDERS=1

# Seconds within which an identical approved intent is suppressed; 0 disables
# duplicate suppression.
VEYRA_RISK_DUPLICATE_WINDOW_SECS=60

# Optional UTC session window, for example 7-21 or 22-6 (wraps midnight).
VEYRA_RISK_SESSION_HOURS_UTC=

# Seconds between automatic broker-state refreshes (0 disables them). The
# refresh keeps close/modify guards and GET /reconciliation current.
VEYRA_RECONCILE_SECS=30

# ---- Persistence (audit trail) ----
# PostgreSQL connection string, for example postgres://localhost/veyra. Unset
# disables durable auditing; a configured but unreachable server fails startup.
VEYRA_DATABASE_URL=

# Days of audit history to keep; the service prunes hourly. 0 keeps everything.
VEYRA_AUDIT_RETENTION_DAYS=30

# ---- Jev decision adapter (TypeSafe System One) ----
# API key for the Jev decision service. Leave unset to disable the adapter.
VEYRA_JEV_API_KEY=

# Optional provider selector. Supported: typesafe (the default once a key is set).
VEYRA_JEV_PROVIDER=typesafe

# Optional base URL override; defaults to the TypeSafe API. Plain http is
# accepted only on loopback, for tests.
VEYRA_JEV_BASE_URL=https://api.typesafe.ai

# Optional model alias; defaults to jev-latest.
VEYRA_JEV_MODEL=jev-latest

# ---- Autopilot (autonomous decision loop) ----
# Runs a decision every interval: market data, optional Jev judgements, one
# structured model proposal, the deterministic risk gate, then the same staged
# execution as the control surface. Disabled by default; the first tick runs
# one interval after startup. Every autonomous entry must carry both a stop
# loss and a take profit.
VEYRA_AUTOPILOT_ENABLED=false

# Optional instrument; defaults to the terminal's chart symbol.
VEYRA_AUTOPILOT_SYMBOL=

# Optional timeframe name or minutes; defaults to H4.
VEYRA_AUTOPILOT_TIMEFRAME=

# Optional closed-candle window, 10-240; defaults to 48.
VEYRA_AUTOPILOT_BARS=

# Optional model tier: fast, balanced, or reasoning; defaults to balanced.
VEYRA_AUTOPILOT_TIER=

# Optional cadence in seconds, 30-86400; defaults to 300.
VEYRA_AUTOPILOT_INTERVAL_SECS=

# Optional judgement preference: auto (consult Jev when configured) or off.
VEYRA_AUTOPILOT_JEV=

# Optional minimum position age before the loop may close it, 0-86400 seconds
# (default 300; 0 disables the guard). Positions whose age cannot be verified
# are never closed autonomously.
# Fraction of ATR(14) a candidate must move inside a candle before the entry
# sweep asks the model again. New closed candles always reopen it; this only
# adds a mid-candle trigger. 0 disables it, leaving candles as the sole
# trigger. Defaults to 0.25.
VEYRA_AUTOPILOT_ENTRY_MOVE_ATR=

VEYRA_AUTOPILOT_MIN_HOLD_SECS=

# Optional break-even policy: multiple of the entry risk (1 = the full stop
# distance) at which the stop moves to the entry price, 0-10 (default 0,
# disabled). Runs before the model review and only when the switch is on.
VEYRA_AUTOPILOT_BREAKEVEN_R=

# Optional trailing policy: once the trade is that many risk units in favour,
# keep the stop that far behind the best price, 0-10 (default 0, disabled).
# The most protective candidate wins over break-even; improvements smaller
# than a tenth of the entry risk are suppressed to bound modify churn.
VEYRA_AUTOPILOT_TRAIL_R=

# ---- Market data ----
# Provider for candles. Supported: ea (closed candles through the EA control
# channel). Leave unset to disable the market view.
VEYRA_MARKET_PROVIDER=

# Optional: how long one rates round trip may take before it is reported
# unavailable, 5-120 seconds (default 20; must outlive the 15s command timeout).
VEYRA_MARKET_EA_AWAIT_SECS=

# ---- Alerting ----
# Off-machine backup: an R2 bucket that receives every fresh dump through the
# authenticated `wrangler` CLI. Leave the bucket unset for local-only backups.
VEYRA_BACKUP_R2_BUCKET=

# Optional absolute path to the wrangler binary (launchd starts with a minimal
# PATH and the node shebang needs the binary's directory on PATH).
VEYRA_WRANGLER_BIN=

# Webhook that receives stack alerts (transitions, drift, repeated autopilot
# failures, executed opens, closed positions). Any endpoint accepting a JSON
# POST with a `text` key works: Slack, Discord, and ntfy all accept the
# payload. Leave unset to log findings under ~/Library/Logs/veyra instead.
VEYRA_ALERT_WEBHOOK=

# ---- Model call budget ----
# Bound the decision engine's provider calls so a runaway loop (an interval
# typo, a retry storm) cannot silently multiply cost. 0 = unlimited (default).
# One tick per minute is 1440 calls per day.
VEYRA_MODEL_MAX_CALLS_PER_HOUR=
VEYRA_MODEL_MAX_CALLS_PER_DAY=

# ---- EA compile-time arming (scripts/compile_ea.sh) ----
# Arms the compiled EA's InAllowLiveOrders input. Default false: the repository
# source never ships armed. This is the second of the two execution controls;
# VEYRA_TRADING_ENABLED below is the first.
# Endpoint the compiled EA polls. MQL4 WebRequest only allows the
# scheme-default ports (80/443), so a tunnelled HTTPS URL is required whenever
# the terminal is not on the same host as the service. Leaving this unset bakes
# in the loopback default, which a Wine terminal cannot reach.
VEYRA_EA_URL=

VEYRA_EA_ALLOW_LIVE=false
